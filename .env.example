# ==============================================================================
# Investment Sentinel - Environment Variable Template
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or production secrets to Git!

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker Compose, use:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/investment_sentinel
SPRING_DATASOURCE_USERNAME=sentinel_user
SPRING_DATASOURCE_PASSWORD=replace_with_a_secure_database_password

# For Cloud Hosted PostgreSQL (e.g. Neon.tech / Supabase / Render Postgres):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech/investment_sentinel?sslmode=require
# SPRING_DATASOURCE_USERNAME=your_cloud_user
# SPRING_DATASOURCE_PASSWORD=your_cloud_password

# ------------------------------------------------------------------------------
# 2. SMS Gateway Configuration
# ------------------------------------------------------------------------------
# Supported providers:
#   - 'startmessaging' : StartMessaging Indian SMS API (provides trial balance)
#   - 'techtor'         : TechTo Networks SMS Gateway
#   - 'fast2sms'       : Fast2SMS Indian SMS API (free initial test balance / OTP / quick route)
#   - 'mock'           : Local safe logger (default for development; logs message without spending credits)
SMS_PROVIDER=mock

# API Key provided by your SMS vendor portal
SMS_API_KEY=your_sms_provider_api_key_here

# 6-character registered DLT Sender ID / Header (e.g., STMSNG, INVSTM, or vendor default)
SMS_SENDER_ID=SENTINEL

# Target recipient mobile number in E.164 format (+91 followed by 10 digits)
SMS_RECIPIENT=+919876543210

# Optional DLT Template ID (Required for Indian Commercial/Promotional DLT compliance)
# Leave blank for trial/testing routes that support direct quick messages
SMS_DLT_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 3. Investment & Monitoring Rule Configuration
# ------------------------------------------------------------------------------
# Scheduled investment review interval in calendar months (Default: 3 months)
REVIEW_INTERVAL_MONTHS=3

# Whether to send alert SMS if a major drawdown threshold (-5%, -15%, -25%) is crossed
# BEFORE the 3-month review date.
# Default: true (alert only; will NOT prompt automatic trades)
EARLY_DRAWDOWN_ALERTS=true

# Schedule timezone (must be Asia/Kolkata as required)
TIMEZONE=Asia/Kolkata

# Cron expression for daily monitoring job (Default: 08:00 AM IST every day)
MONITORING_CRON="0 0 8 * * ?"

# ------------------------------------------------------------------------------
# 4. ATLAS GLOBAL (US Equity) Contribution Rules (USD)
# ------------------------------------------------------------------------------
ATLAS_NORMAL_AMOUNT=25
ATLAS_DRAWDOWN_1=5
ATLAS_AMOUNT_1=50
ATLAS_DRAWDOWN_2=15
ATLAS_AMOUNT_2=75
ATLAS_DRAWDOWN_3=25
ATLAS_AMOUNT_3=100

# ------------------------------------------------------------------------------
# 5. ICICI Prudential Gold ETF Contribution Rules (INR)
# ------------------------------------------------------------------------------
GOLD_NORMAL_AMOUNT=2000
GOLD_DRAWDOWN_1=5
GOLD_AMOUNT_1=4000
GOLD_DRAWDOWN_2=15
GOLD_AMOUNT_2=6000
GOLD_DRAWDOWN_3=25
GOLD_AMOUNT_3=8000

# ------------------------------------------------------------------------------
# 6. Market Data Provider
# ------------------------------------------------------------------------------
# Supported providers: 'yahoo' (default, free, no key needed), 'alphavantage', 'mock'
MARKET_DATA_PROVIDER=yahoo
ALPHA_VANTAGE_API_KEY=
